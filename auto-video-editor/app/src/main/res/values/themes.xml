<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AutoCut" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_system_bars</item>
        <!-- Without this the navigation icons stay light against a near-white
             surface, so on a three-button device the glyphs vanish. -->
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <!-- Chips are created in code, so they pick up chipStyle. The Material3
             default is an assist chip, which has no checked-state visuals at
             all: with single-selection style pickers, every option looked
             identical and the selected one was invisible. -->
        <item name="chipStyle">@style/Widget.Material3.Chip.Filter</item>
    </style>
</resources>
